{
  "name": "claimshield-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Amyna Relay patient-experience service (talks only to Core's HTTP API)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../shared/openapi/core.openapi.json -o ../shared/ts/core.ts --default-non-nullable=false"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
