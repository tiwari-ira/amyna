# =============================================================================
# Amyna PRODUCTION environment template
# -----------------------------------------------------------------------------
# Production serves real patients. Startup is FAIL-CLOSED
# (core/app/config.py::environment_mistakes + missing_live_settings): the process
# refuses to launch unless every integration is a live, verified adapter and
# every secret is a real value sourced from a secrets manager (never a committed
# file). See docs/DEPLOYMENT.md before any deployment.
#
# NON-NEGOTIABLE in production:
#   * PostgreSQL DATABASE_URL (no SQLite fallback).
#   * TELNYX_WEBHOOK_VERIFY=true and TELNYX_PUBLIC_KEY set.
#   * An https PUBLIC_BASE_URL (no localhost, no tunnel/ngrok).
#   * NOTIFY_MODE=relay_service, FETCH_MODE=agentverse.
#   * XAI_VOICE_MODE=live, TELEPHONY_MODE=live.
#   * FINCHNODE_MODE=production with a real (non-sandbox) FinchNode key.
# =============================================================================

APP_ENV=prod
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://amyna:REPLACE_ME@PROD_DB_HOST:5432/amyna
CORE_BASE_URL=https://core.amyna.example.com
CORE_PORT=8080

# Real per-service tokens. Inject from your secrets manager at deploy time.
RELAY_SERVICE_TOKEN=
FETCH_SERVICE_TOKEN=
VOICE_SERVICE_TOKEN=
CORE_WEBHOOK_SECRET=

NOTIFY_MODE=relay_service
RELAY_SERVICE_URL=https://relay.amyna.example.com

# --- live voice + telephony ---
XAI_VOICE_MODE=live
XAI_API_KEY=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_VOICE_MODEL=
XAI_VOICE_NAME=

TELEPHONY_MODE=live
PUBLIC_BASE_URL=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_VERIFY=true
XAI_SIP_URI=
# Required: the signing secret xAI returns when the SIP number is registered.
XAI_WEBHOOK_SIGNING_SECRET=
TELEPHONY_ALLOWED_NUMBERS=
HUMAN_HANDOFF_PHONE=

# --- Fetch.ai agent network (persistent) ---
FETCH_MODE=agentverse
ORCHESTRATOR_URL=https://agents.amyna.example.com
AGENTVERSE_API_KEY=
ORCHESTRATOR_SEED=
VISIT_AGENT_SEED=
CLAIM_AGENT_SEED=
DISPUTE_AGENT_SEED=
VISIT_AGENT_ADDRESS=
CLAIM_AGENT_ADDRESS=
DISPUTE_AGENT_ADDRESS=
ORCHESTRATOR_ADDRESS=
HELLO_WORLD=0
AGENT_REQUEST_TIMEOUT_S=60
ORCHESTRATOR_HANDLE=

# --- FinchNode PRODUCTION (patient-authorized records API) ---
FINCHNODE_MODE=production
FINCHNODE_API_KEY=
FINCHNODE_BASE_URL=

EXTRACTION_MODE=rules
OLLAMA_URL=
OLLAMA_MODEL=

# --- Relay service (Node, relay/) ---
RELAY_MODE=live
RELAY_PORT=3000
RELAY_AGENT_TOKEN=
RELAY_WEBHOOK_SECRET=
RELAY_API_BASE_URL=
XAI_STT_URL=https://api.x.ai/v1/stt
RELAY_VISIT_POLL_MS=2000
RELAY_VISIT_WAIT_MS=90000
RELAY_DATA_DIR=
