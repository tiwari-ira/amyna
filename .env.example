# =============================================================================
# Amyna environment template
# -----------------------------------------------------------------------------
# Copy to .env (`make setup` does this for you). Every value below is either a
# safe default or intentionally EMPTY. With nothing filled in, everything runs
# in MOCK mode: `make dev-local`, `make test`, `make smoke` all work.
#
# NEVER commit real values. `.env` is git-ignored.
# Each integration has a *_MODE flag. Flipping a flag to a live value without
# its keys makes the process FAIL FAST at startup with a message naming the
# missing variable (see docs/SETUP_KEYS.md).
# =============================================================================

# =============================================================================
# [Member 1] Core service (main branch)
# =============================================================================
# dev | test | prod. In prod, service tokens/secrets below are REQUIRED (no dev
# fallbacks) and live adapters must be fully configured.
APP_ENV=dev
LOG_LEVEL=INFO
# Empty => local SQLite file at .data/amyna.db (docker-compose overrides
# this with Postgres). Example Postgres URL:
#   postgresql+psycopg://amyna:amyna_dev@localhost:5432/amyna
DATABASE_URL=
# Where other services (Relay service, Fetch agents, smoke test) reach Core.
CORE_BASE_URL=http://localhost:8080
CORE_PORT=8080

# Service tokens: one per caller, each with its own scopes (core/app/auth.py).
# Empty in dev/test => built-in dev tokens are used (dev-relay-token, ...).
# Generate real ones with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SERVICE_TOKEN=
FETCH_SERVICE_TOKEN=
VOICE_SERVICE_TOKEN=
# HMAC secret for signed events Relay service -> Core POST /relay/webhook.
# Empty in dev/test => dev-core-webhook-secret.
CORE_WEBHOOK_SECRET=

# Findings with confidence below this threshold (and that a patient can
# answer) require explicit patient confirmation before they are disputed.
CONFIRMATION_THRESHOLD=0.9

# How Core delivers patient notifications:
#   outbox        => store in DB only (GET /cases/{id}/notifications). Default.
#   relay_service => also POST to the Relay service at RELAY_SERVICE_URL.
NOTIFY_MODE=outbox

# =============================================================================
# [Member 1] xAI Grok Voice + telephony (Core owns the call session)
# =============================================================================
# mock => scripted fake insurer rep (deterministic, includes the SSN handoff).
# live => xAI realtime WebSocket session (core/app/adapters/xai_voice/live.py).
XAI_VOICE_MODE=mock
XAI_API_KEY=
# VERIFY against current xAI docs before going live:
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_VOICE_MODEL=
XAI_VOICE_NAME=

# mock => fake dialer. live => Telnyx Call Control bridged to xAI SIP.
TELEPHONY_MODE=mock
# Public HTTPS URL of this Core (ngrok). Telnyx posts signed call events to
# {PUBLIC_BASE_URL}/voice/telnyx/webhook; the insurer -> xAI SIP bridge depends on it.
PUBLIC_BASE_URL=
# Telnyx (Mission Control): API v2 key, Voice API (Call Control) connection, caller number.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
# Ed25519 public key for webhook verification: Mission Control -> API keys -> Public key.
TELNYX_PUBLIC_KEY=
# Skip webhook signature verification when the public key is unavailable
# (demo only: unauthenticated webhooks are then accepted).
TELNYX_WEBHOOK_VERIFY=true
# SIP URI that terminates on xAI's SIP bridge. Docs-verified: xAI's SIP is
# inbound; Telnyx transfers the insurer leg to sip:{your-xai-number}@sip.voice.x.ai,
# then xAI posts a signed realtime.call.incoming webhook to /voice/xai/webhook
# and the realtime WS attaches with ?call_id= (see core/app/adapters/xai_voice/sip_webhook.py).
XAI_SIP_URI=
# Signing secret returned when you register the number with xAI (returned once).
# Required when live telephony bridges calls over SIP (fail-closed); the inbound
# webhook uses webhook-id / webhook-timestamp / webhook-signature headers.
XAI_WEBHOOK_SIGNING_SECRET=
# Comma-separated E.164 numbers Core is allowed to dial. Anything else is
# refused, even in live mode. Keep this to test lines during the hackathon.
# Both demo insurer lines (the original synthetic one and the demo payer line).
TELEPHONY_ALLOWED_NUMBERS=+15555550100,+12487208903
# Insurer phone directory for payers whose records carry no phone (FinchNode
# coverage never does): "Payer Name=+1...;Other Payer=+1...". The number must also
# be in TELEPHONY_ALLOWED_NUMBERS. Example for FinchNode's synthetic sandbox patient:
#   PAYER_PHONES=Example Health Plan (Synthetic)=+12487208903
PAYER_PHONES=
# A call-pausing handoff (SSN/PIN request...) dials the patient into the call.
# It dials the case's own number (the patient confirms it in Relay before the
# call), else this fallback phone. Must be inside TELEPHONY_ALLOWED_NUMBERS.
HUMAN_HANDOFF_PHONE=
# true => the patient's own confirmed number may be dialed for the handoff even
# though it is not in TELEPHONY_ALLOWED_NUMBERS (one number per patient).
TELEPHONY_ALLOW_PATIENT_PHONES=false
# Seconds the patient has to answer the handoff call; after that the insurer is
# told the member couldn't be reached and the AI continues (insurer stays on).
HUMAN_MERGE_TIMEOUT_S=75
# true => Telnyx answering-machine detection hangs up on voicemail (the patient
# gets a "text call to retry" message). Set false if an insurer's IVR greeting is
# mistaken for a machine.
TELEPHONY_VOICEMAIL_DETECTION=true
# Optional Telnyx fallback profiles, used in order when the primary account
# is rejected (auth/credit). Each must be a complete key+connection+number.
TELNYX_API_KEY_2=
TELNYX_CONNECTION_ID_2=
TELNYX_PHONE_NUMBER_2=
TELNYX_API_KEY_3=
TELNYX_CONNECTION_ID_3=
TELNYX_PHONE_NUMBER_3=

# =============================================================================
# [Member 2] Relay patient experience (branch-1-relay, Node service in relay/)
# =============================================================================
# mock => in-memory outbox + console output, no Relay account needed.
# live => Relay platform via relay/src/relayAdapter/live.ts (VERIFY endpoints).
RELAY_MODE=mock
RELAY_PORT=3000
# Where Core reaches the Relay service when NOTIFY_MODE=relay_service.
RELAY_SERVICE_URL=http://localhost:3000
# Issued by the Relay platform (VERIFY names in Relay docs):
RELAY_AGENT_TOKEN=
RELAY_WEBHOOK_SECRET=
RELAY_API_BASE_URL=
# live mode transcribes visit voice memos with xAI speech-to-text using XAI_API_KEY
# (above). Override the endpoint only for testing.
XAI_STT_URL=https://api.x.ai/v1/stt
# With FETCH_MODE=agentverse the Visit Agent finishes after Core answers; the Relay
# service checks Core this often, for this long, before telling the patient it's slow.
RELAY_VISIT_POLL_MS=2000
RELAY_VISIT_WAIT_MS=90000
# Ask the patient for their own number before an insurer call (the handoff leg).
# Defaults to true with RELAY_MODE=live, false in mock.
RELAY_ASK_CALLBACK_PHONE=
# Where the Relay service keeps conversations, the event ledger and recordings
# (PHI: git-ignored). Empty => relay/data.
RELAY_DATA_DIR=

# =============================================================================
# [Member 3] Fetch.ai uAgents / Agentverse / ASI:One (branch-2-fetch)
# =============================================================================
# local_direct => Core runs fetch/agents/logic/* in-process (no Agentverse).
# agentverse   => Core triggers the orchestrator's REST endpoint and agents
#                 write results back through /internal/tools/*.
FETCH_MODE=local_direct
# Not read by the code yet: the mailbox is connected through the Agentverse
# inspector link. Needed only if you script registration via the Agentverse API
# (VERIFY against current docs).
AGENTVERSE_API_KEY=
# Seeds ONLY come from env. Agents refuse to start without them and never log
# them. Generate: python -c "import secrets; print(secrets.token_hex(32))"
ORCHESTRATOR_SEED=
VISIT_AGENT_SEED=
CLAIM_AGENT_SEED=
DISPUTE_AGENT_SEED=
# Specialist addresses (agent1q...). Print them from your seeds with:
#   make agent-addresses
VISIT_AGENT_ADDRESS=
CLAIM_AGENT_ADDRESS=
DISPUTE_AGENT_ADDRESS=
# Specialists only answer this address (case data is PHI). Required when the
# specialists run as their own mailbox agents (run_all --processes).
ORCHESTRATOR_ADDRESS=
# Core -> orchestrator REST trigger (FETCH_MODE=agentverse only).
ORCHESTRATOR_URL=http://localhost:8000
# 1 => orchestrator only replies "Hello from Amyna" (validate ASI:One
# discoverability first; it is the riskiest sponsor integration).
HELLO_WORLD=0
# Seconds before the orchestrator gives up on a specialist reply.
AGENT_REQUEST_TIMEOUT_S=60
# Optional Agentverse handle for the public orchestrator profile (VERIFY).
ORCHESTRATOR_HANDLE=

# =============================================================================
# [Member 4] FinchNode health data + intelligence (branch-2-fetch)
# =============================================================================
# mock       => local synthetic fixtures (finchnode/fixtures), no network. Patients
#               type an id (fn_pat_demo_001) and the sample bill is CLM-2026-0915-001.
# demo       => FinchNode's public fake API, no key (patients type patient-demo-001).
# sandbox    => production behaviour with synthetic patients: hosted Connect links,
#               signed webhooks, FinchNode's named scenarios. Needs a ck_test_ key
#               from the FinchNode console (finchnode.com -> Applications).
# production => real, patient-authorized records (ck_live_ key; app enabled).
# FinchNode is read-only: it never holds an itemized bill (claims are summaries)
# or an insurer phone. See docs/FINCHNODE_SANDBOX_DEMO.md.
FINCHNODE_MODE=mock
FINCHNODE_API_KEY=
# Optional: sandbox and production both default to https://api.finchnode.com/api/v1.
FINCHNODE_BASE_URL=
# The application's webhook signing secret (whsec_...): console -> Applications ->
# Webhook signatures, after setting the webhook URL to {PUBLIC_BASE_URL}/finchnode/webhook.
FINCHNODE_WEBHOOK_SECRET=
# What a Connect link asks the patient to share (each must be on the app's list).
FINCHNODE_CONNECT_CATEGORIES=demographics,encounters,labs,medications,claims,documents
# continuous => FinchNode re-imports and sends records.updated when new records
# arrive (the app must be set to continuous). Empty = the app's own setting.
FINCHNODE_SYNC_MODE=
# Optional page FinchNode's "Return to Amyna" button opens when the patient finishes.
FINCHNODE_CONNECT_RETURN_URL=

# rules  => deterministic keyword/regex extractor (no model needed).
# ollama => local Qwen3 via Ollama with strict JSON-schema output.
EXTRACTION_MODE=rules
OLLAMA_URL=http://localhost:11434
# VERIFY the tag you pulled: `ollama pull qwen3:1.7b` (or qwen3:0.6b).
OLLAMA_MODEL=qwen3:1.7b
