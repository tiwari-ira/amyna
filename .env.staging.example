# =============================================================================
# Amyna STAGING environment template
# -----------------------------------------------------------------------------
# Staging mirrors production closely but uses ONLY synthetic patient data,
# sandbox FinchNode, and test telephony numbers. It exists to prove the full
# patient -> Relay -> Core -> agents -> FinchNode -> xAI -> Telnyx -> guardian
# path against real (non-customer) infrastructure before launch.
#
# Startup is FAIL-CLOSED (core/app/config.py::environment_mistakes): this process
# refuses to start unless every value below is set to a real non-default value
# and every integration is a live adapter. Never commit real secrets.
# =============================================================================

APP_ENV=staging
LOG_LEVEL=INFO
# Staging must run on PostgreSQL (never the SQLite fallback).
DATABASE_URL=postgresql+psycopg://amyna:REPLACE_ME@STAGING_DB_HOST:5432/amyna_staging
CORE_BASE_URL=https://core.staging.amyna.example.com
CORE_PORT=8080

# Real service tokens (no dev fallbacks in staging). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SERVICE_TOKEN=
FETCH_SERVICE_TOKEN=
VOICE_SERVICE_TOKEN=
CORE_WEBHOOK_SECRET=

# Patients are actually notified through the deployed Relay service.
NOTIFY_MODE=relay_service
RELAY_SERVICE_URL=https://relay.staging.amyna.example.com

# --- live voice + telephony (Core owns the call session) ---
XAI_VOICE_MODE=live
XAI_API_KEY=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_VOICE_MODEL=
XAI_VOICE_NAME=

TELEPHONY_MODE=live
# Public HTTPS endpoint. Staging may use a tunnel for the counterparty webhook,
# but production refuses one.
PUBLIC_BASE_URL=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
# REQUIRED and verified: webhook signature verification cannot be off in staging.
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_VERIFY=true
XAI_SIP_URI=
# Signing secret returned when the SIP number is registered with xAI.
XAI_WEBHOOK_SIGNING_SECRET=
# Allow only the synthetic insurer line(s) used for staging tests.
TELEPHONY_ALLOWED_NUMBERS=+15555550100
# The test "patient" phone that the guardian-handoff merge dials.
HUMAN_HANDOFF_PHONE=

# --- Fetch.ai agent network (persistent, not in-process) ---
FETCH_MODE=agentverse
ORCHESTRATOR_URL=https://agents.staging.amyna.example.com
AGENTVERSE_API_KEY=
ORCHESTRATOR_SEED=
VISIT_AGENT_SEED=
CLAIM_AGENT_SEED=
DISPUTE_AGENT_SEED=
VISIT_AGENT_ADDRESS=
CLAIM_AGENT_ADDRESS=
DISPUTE_AGENT_ADDRESS=
ORCHESTRATOR_ADDRESS=
HELLO_WORLD=0
AGENT_REQUEST_TIMEOUT_S=60
ORCHESTRATOR_HANDLE=

# --- FinchNode SANDBOX (synthetic patient data; ck_test_ key) ---
FINCHNODE_MODE=sandbox
FINCHNODE_API_KEY=
FINCHNODE_BASE_URL=

EXTRACTION_MODE=rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# --- Relay service (Node, relay/) ---
RELAY_MODE=live
RELAY_PORT=3000
RELAY_AGENT_TOKEN=
RELAY_WEBHOOK_SECRET=
RELAY_API_BASE_URL=
XAI_STT_URL=https://api.x.ai/v1/stt
RELAY_VISIT_POLL_MS=2000
RELAY_VISIT_WAIT_MS=90000
RELAY_DATA_DIR=
